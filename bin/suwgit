#!/usr/bin/env bash
# Runs suwgit straight from the clone, before `just install` has put it on PATH.
# -X utf8: console output and file names in UTF-8, not the ANSI code page.
set -euo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
PYTHON="$(command -v python3 || command -v python)"
exec "$PYTHON" -X utf8 "$REPO/bin/suwgit.py" "$@"
